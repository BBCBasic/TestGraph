ENVIRONMENT=development
DATABASE_URL=sqlite:///./tastegraph.db
APP_SECRET=replace-with-a-long-random-secret
DEVELOPMENT_API_KEY=replace-with-a-long-random-development-key
CLIENT_API_KEYS={}
PUBLIC_BASE_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=["127.0.0.1","localhost","testserver"]
CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
LOG_LEVEL=INFO
OAUTH_OWNER_USER_ID=
OAUTH_CONNECTION_CODE=replace-with-a-long-private-connection-code

